\section*{Zadanie 1. Generowanie danych}

<<dane>>=
set.seed(7)
n <- 10
x <- (1:n)/2
beta_true <- c(10, 3, 2)
sigma_true <- 1/2

g <- function(x, beta) beta[1]*x/(beta[2]+x) + beta[3]

y <- g(x, beta_true) + rnorm(n, 0, sigma_true)
y
@

\section*{Zadanie 2. Funkcja $g$ i jej gradient}

$$g(x,\beta) = \frac{\beta_1 x}{\beta_2 + x} + \beta_3$$

$$\nabla g = \left( \frac{x}{\beta_2+x},\ -\frac{\beta_1 x}{(\beta_2+x)^2},\ 1 \right)$$

<<gradient>>=
grad_g <- function(x, beta) {
  cbind(
    x/(beta[2]+x),
    -beta[1]*x/(beta[2]+x)^2,
    rep(1, length(x))
  )
}
@

\section*{Zadanie 3. Algorytm Gaussa-Newtona}

<<gn>>=
gauss_newton <- function(x, y, beta0, tol=1e-4, max_iter=100) {
  n <- length(y)
  beta <- beta0
  history <- list(beta0)
  
  rss <- function(b) sum((y - g(x, b))^2)
  
  r0 <- y - g(x, beta)
  sigma2_hist <- sum(r0^2)/n
  loglik_hist <- -n/2*log(2*pi*sigma2_hist) - sum(r0^2)/(2*sigma2_hist)
  
  for (s in 1:max_iter) {
    r <- y - g(x, beta)
    J <- grad_g(x, beta)
    JtJ <- t(J) %*% J
    
    r_new <- y - g(x, beta_new)
    sigma2_new <- sum(r_new^2)/n
    ll_new <- -n/2*log(2*pi*sigma2_new) - sum(r_new^2)/(2*sigma2_new)
    
    history[[s+1]] <- beta_new
    sigma2_hist <- c(sigma2_hist, sigma2_new)
    loglik_hist <- c(loglik_hist, ll_new)
    
    if (sqrt(sum((beta_new - beta)^2)) <= tol) {
      beta <- beta_new
      break
    }
    beta <- beta_new
  }
  
  list(beta=beta, history=history, sigma2=sigma2_hist, 
       loglik=loglik_hist, iter=length(history)-1)
}

wynik1 <- gauss_newton(x, y, c(8, 2, 1))
wynik1$beta
wynik1$iter
@
