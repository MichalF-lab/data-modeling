\begin{document}

<<setup, include=FALSE>>=
knitr::opts_chunk$set(echo=TRUE, warning=FALSE, message=FALSE, fig.width=6, fig.height=4)
@

\section*{Generowanie danych}


Uwaga prez pomyłke nie dałem set seed!

<<losowanie>>=
set.seed(122112)
n<-300
p<-20
X<-matrix(rnorm(n*p,2,5),ncol=p,nrow=n)
X[,1]<-rep(1,n)
beta<-c(rnorm(10,0,1/4),numeric(10))
pi.p<-1/(1+exp(-X%*%beta))
colnames(X)<-sapply(1:p,function(i){paste0("X",i)})
dane<-data.frame(X)
dane$Y<-rbinom(n,1,pi.p)
write.csv(dane,"daneG5.csv",row.names=F)
@

<<podzial>>=
id.0<-which(dane$Y==0)
id.1<-which(dane$Y==1)

train.0<-sample(id.0,size=floor(0.7*length(id.0)))
train.1<-sample(id.1,size=floor(0.7*length(id.1)))

id.train<-sort(c(train.0,train.1))
id.test<-setdiff(seq_len(n),id.train)

train<-dane[id.train,]
test<-dane[id.test,]
@

\section*{Konstrukcja modelu2}

<<model2>>=

model.full<-glm(Y~.,data=train[,-1],family=binomial)
model.null<-glm(Y~1,data=train[,-1],family=binomial)

model2 <- glm(Y ~ ., data = train[, -1], family = binomial)
@

<<cosos2>>=
pred.test<-predict(model2,
                   newdata=test,type='response')

wskaźniki<-function(poziom=0.5){
  pred.class<-ifelse(pred.test>poziom,1,0)
  cm<-table(pred=pred.class,real=test$Y)
  sen<-cm[2,2]/sum(cm[,2])
  spec<-cm[1,1]/sum(cm[,1])
  fpr<-cm[2,1]/sum(cm[,1])
  fnr<-cm[1,2]/sum(cm[,2])
  acc<-sum(diag(cm))/sum(cm)
  miary<-c(sen,spec,fpr,fnr,acc)
  names(miary)<-c("sen","spec","fpr","fnr","acc")
  return(list(cm=cm,miary=miary))
}

M.1<-wskaźniki(0.5)
M.2<-wskaźniki(0.7)

cbind(M.1$miary,M.2$miary)
@

<<dalej2>>=
library(pROC)
roc.obj<-roc(test2$Y,pred.test2)
auc(roc.obj)
plot(roc.obj,col='red')
@


\section*{Konstrukcja modelu}

<<model>>=

model.full<-glm(Y~.,data=train[,-1],family=binomial(link="probit"))
model.null<-glm(Y~1,data=train[,-1],family=binomial(link="probit"))

model <- step(model.null, scope = list(lower = model.null, upper = model.full), direction = "forward")
@

<<cosos>>=
pred.test<-predict(model,
                   newdata=test,type='response')

wskaźniki<-function(poziom=0.5){
  pred.class<-ifelse(pred.test>poziom,1,0)
  cm<-table(pred=pred.class,real=test$Y)
  sen<-cm[2,2]/sum(cm[,2])
  spec<-cm[1,1]/sum(cm[,1])
  fpr<-cm[2,1]/sum(cm[,1])
  fnr<-cm[1,2]/sum(cm[,2])
  acc<-sum(diag(cm))/sum(cm)
  miary<-c(sen,spec,fpr,fnr,acc)
  names(miary)<-c("sen","spec","fpr","fnr","acc")
  return(list(cm=cm,miary=miary))
}

Mm.1<-wskaźniki(0.5)
Mm.2<-wskaźniki(0.7)

cbind(M.1$miary,M.2$miary)
@

<<dalej>>=
library(pROC)
roc.obj<-roc(test$Y,pred.test)
auc(roc.obj)
plot(roc.obj,col='red')
@


\section*{Konstrukcja modelu3}

<<model3>>=

model.full<-glm(Y~.,data=train[,-1],family=binomial(link="probit"))
model.null<-glm(Y~1,data=train[,-1],family=binomial(link="probit"))

model3 <- step(model.null, scope = list(lower = model.null, upper = model.full), direction = "forward",  k = log(nrow(train)))
@

<<cosos3>>=
pred.test<-predict(model3,
                   newdata=test,type='response')

wskaźniki<-function(poziom=0.5){
  pred.class<-ifelse(pred.test>poziom,1,0)
  cm<-table(pred=pred.class,real=test$Y)
  sen<-cm[2,2]/sum(cm[,2])
  spec<-cm[1,1]/sum(cm[,1])
  fpr<-cm[2,1]/sum(cm[,1])
  fnr<-cm[1,2]/sum(cm[,2])
  acc<-sum(diag(cm))/sum(cm)
  miary<-c(sen,spec,fpr,fnr,acc)
  names(miary)<-c("sen","spec","fpr","fnr","acc")
  return(list(cm=cm,miary=miary))
}

Mmm.1<-wskaźniki(0.5)
Mmm.2<-wskaźniki(0.7)

cbind(Mmm.1$miary,Mmm.2$miary)
@

<<dalej3>>=
library(pROC)
roc.obj<-roc(test$Y,pred.test)
auc(roc.obj)
plot(roc.obj,col='red')
@


<<podusmowanie>>=
nazwy <- names(coef(model))
nazwy2 <- names(coef(model2))
nazwy3 <- names(coef(model3))
wynik <- cbind(beta=beta, oszacowanieAIC = coef(model)[nazwy], oszacowanielog = coef(model2)[nazwy2], oszacowanieBIC = coef(model3)[nazwy3])
wynik[is.na(wynik)] <- 0
wynik
@

<<podusmowanie2>>=
cbind(log05=M.1$miary,log07=M.2$miary, AIC05=Mm.1$miary,AIC07=Mm.2$miary, BIC05=Mmm.1$miary,BIC07=Mmm.2$miary)
@
